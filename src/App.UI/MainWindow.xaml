<Window x:Class="SmartNetworkTrafficAnalyzer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:viewModels="clr-namespace:SmartNetworkTrafficAnalyzer.UI.ViewModels"
        mc:Ignorable="d"
        Title="Smart Network Traffic Analyzer" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="12,8">
            <TextBlock Text="🔍 Smart Network Traffic Analyzer" FontSize="20" FontWeight="Bold"/>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding TotalConnections, StringFormat='{}{0} connections'}"
                       Foreground="Gray" Margin="0,0,8,0"/>
            <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="Gray"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                <Setter Property="Fill" Value="LimeGreen"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </DockPanel>

        <!-- Separator -->
        <Separator Grid.Row="1" Margin="12,0"/>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Connection Grid -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Connections}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Name="grid"
                      SelectedItem="{Binding SelectedConnection}"
                      CanUserSortColumns="True"
                      AlternatingRowBackground="#F8F9FA"
                      GridLinesVisibility="Horizontal">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding SequentialId}" Width="45"/>
                    <DataGridTextColumn Header="First Seen" Binding="{Binding FirstSeen, StringFormat='{}{0:HH:mm:ss}'}" Width="75"/>
                    <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="50"/>
                    <DataGridTextColumn Header="Remote IP" Binding="{Binding RemoteIp}" Width="110"/>
                    <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="130"/>
                    <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="55"/>
                    <DataGridTextColumn Header="Port" Binding="{Binding RemotePort}" Width="50"/>
                    <DataGridTextColumn Header="Risk" Binding="{Binding RiskDisplay}" Width="85"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding SecurityCategory}" Width="100"/>
                    <DataGridTextColumn Header="Score" Binding="{Binding SecurityLevel}" Width="70"/>
                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="90"/>
                    <DataGridTextColumn Header="In" Binding="{Binding BytesInFormatted}" Width="65"/>
                    <DataGridTextColumn Header="Out" Binding="{Binding BytesOutFormatted}" Width="65"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Right Panel -->
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Bandwidth Chart -->
                <Border BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                    <oxy:PlotView Model="{Binding BandwidthModel}"/>
                </Border>

                <!-- Details Panel -->
                <Border Grid.Row="1" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Connection Details -->
                            <TextBlock Text="📋 Connection Details" Style="{StaticResource HeaderLabel}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🌐 IP:" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Text="{Binding ElementName=grid, Path=SelectedItem.RemoteIp}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🏠 Hostname:" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Text="{Binding ElementName=grid, Path=SelectedItem.Hostname}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🌍 Country:" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Text="{Binding ElementName=grid, Path=SelectedItem.Country}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="⚙️ Process:" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Text="{Binding ElementName=grid, Path=SelectedItem.ProcessName}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="⚠️ Risk:" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Text="{Binding ElementName=grid, Path=SelectedItem.RiskDisplay}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🏷️ Category:" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Text="{Binding ElementName=grid, Path=SelectedItem.SecurityCategory}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="📊 Score:" Style="{StaticResource DetailLabel}"/>
                                <TextBlock Text="{Binding ElementName=grid, Path=SelectedItem.SecurityLevel}"/>
                            </StackPanel>

                            <Separator Margin="0,8"/>

                            <!-- Ollama Analysis -->
                            <TextBlock Text="🤖 AI Analysis" Style="{StaticResource HeaderLabel}"/>
                            <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1"
                                    Padding="8" CornerRadius="4">
                                <TextBlock Text="{Binding ElementName=grid, Path=SelectedItem.OllamaAnalysis}"
                                           TextWrapping="Wrap"
                                           FontFamily="Segoe UI"
                                           LineHeight="20"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>