<Window x:Class="SmartNetworkTrafficAnalyzer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:SmartNetworkTrafficAnalyzer.UI"
    xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:viewModels="clr-namespace:SmartNetworkTrafficAnalyzer.UI.ViewModels"
        mc:Ignorable="d"
        Title="Smart Network Traffic Analyzer" Height="600" Width="1100">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="8">
            <TextBlock Text="Live Traffic" FontSize="18" FontWeight="Bold"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0" ItemsSource="{Binding Connections}" AutoGenerateColumns="False" IsReadOnly="True" Name="grid" SelectedItem="{Binding SelectedConnection}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding SequentialId}" Width="50"/>
                    <DataGridTextColumn Header="FirstSeen" Binding="{Binding FirstSeen}"/>
                    <DataGridTextColumn Header="Direction" Binding="{Binding Direction}"/>
                    <DataGridTextColumn Header="Local" Binding="{Binding LocalEndpoint}"/>
                    <DataGridTextColumn Header="Remote IP" Binding="{Binding RemoteIp}"/>
            <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}"/>
            <DataGridTextColumn Header="Country" Binding="{Binding Country}"/>
                    <DataGridTextColumn Header="Port" Binding="{Binding RemotePort}"/>
                    <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}"/>
                    <DataGridTextColumn Header="Risk" Binding="{Binding Risk}"/>
                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}"/>
                    <DataGridTextColumn Header="In" Binding="{Binding BytesInFormatted}"/>
                    <DataGridTextColumn Header="Out" Binding="{Binding BytesOutFormatted}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <oxy:PlotView Grid.Row="0" Model="{Binding BandwidthModel}" />
                <Border Grid.Row="1" BorderBrush="#ddd" BorderThickness="1" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="📋 Détails de connexion" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🌐 IP: " FontWeight="SemiBold" MinWidth="80"/>
                                <TextBlock Text="{Binding ElementName=grid, Path=SelectedItem.RemoteIp}"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🏠 Hostname: " FontWeight="SemiBold" MinWidth="80"/>
                                <TextBlock Text="{Binding ElementName=grid, Path=SelectedItem.Hostname}"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="🌍 Pays: " FontWeight="SemiBold" MinWidth="80"/>
                                <TextBlock Text="{Binding ElementName=grid, Path=SelectedItem.Country}"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="⚙️ Processus: " FontWeight="SemiBold" MinWidth="80"/>
                                <TextBlock Text="{Binding ElementName=grid, Path=SelectedItem.ProcessName}"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="⚠️ Risque: " FontWeight="SemiBold" MinWidth="80"/>
                                <TextBlock Text="{Binding ElementName=grid, Path=SelectedItem.Risk}"/>
                            </StackPanel>
                            
                            <Separator Margin="0,8"/>
                            
                            <TextBlock Text="🤖 Analyse Ollama" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                            <Border Background="#f8f9fa" BorderBrush="#dee2e6" BorderThickness="1" Padding="8" CornerRadius="4">
                                <TextBlock Text="{Binding ElementName=grid, Path=SelectedItem.OllamaAnalysis}" 
                                          TextWrapping="Wrap" 
                                          FontFamily="Segoe UI"
                                          LineHeight="20"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
